{
  "functions": {
    "api/app.py": { 
      "runtime": "python3.11",
      "memory": 1024
    }
  },
  "routes": [
    { 
      "src": "/api/(.*)", 
      "dest": "/api/app.py",
      "methods": ["GET", "POST", "OPTIONS"]
    }
  ],
  "buildCommand": "next build",
  "devCommand": "next dev",
  "outputDirectory": ".next",
  "framework": "nextjs"

}