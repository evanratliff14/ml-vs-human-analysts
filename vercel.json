{
  "version": 2,
  "builds": [
    { 
      "src": "api/index.py", 
      "use": "@vercel/python"
    },
    { 
      "src": "web/package.json", 
      "use": "@vercel/next" 
    }
  ],
  "functions": {
    "api/index.py": {
      "runtime": "python3.11",
      "memory": 1024
    }
  },
  "rewrites": [
    {
      "source": "/api/:path*",
      "destination": "/api/index.py"
    }
  ]
}